material HelloMine3D/Flora
{
    technique
    {
        pass
        {
            lighting off
            depth_write on
            cull_hardware none

            vertex_program_ref HelloMine3D/FloraVertex
            {
            }

            fragment_program_ref HelloMine3D/TerrainFragment
            {
            }

            texture_unit terrainAtlas
            {
                texture DefaultPack.png
                tex_address_mode clamp
                filtering none
            }
        }
    }
}

material HelloMine3D/Outline
{
    technique
    {
        pass
        {
            lighting off
            depth_check on
            depth_write off
            scene_blend alpha_blend

            vertex_program_ref HelloMine3D/OutlineVertex
            {
            }

            fragment_program_ref HelloMine3D/OutlineFragment
            {
            }
        }
    }
}

material HelloMine3D/ActorMob
{
    technique
    {
        pass
        {
            lighting off
            depth_write on
            cull_hardware none

            vertex_program_ref HelloMine3D/ActorVertex
            {
            }

            fragment_program_ref HelloMine3D/ActorFragment
            {
                param_named actorTint float4 0.24 0.78 0.30 1.0
            }
        }
    }
}

material HelloMine3D/ActorItem
{
    technique
    {
        pass
        {
            lighting off
            depth_write on
            cull_hardware none

            vertex_program_ref HelloMine3D/ActorVertex
            {
            }

            fragment_program_ref HelloMine3D/ActorFragment
            {
                param_named actorTint float4 1.0 0.67 0.12 1.0
            }
        }
    }
}
