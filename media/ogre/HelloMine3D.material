material HelloMine3D/Skybox
{
    technique
    {
        pass
        {
            lighting off
            depth_write off

            vertex_program_ref HelloMine3D/SkyboxVertex
            {
            }

            fragment_program_ref HelloMine3D/SkyboxFragment
            {
            }

            texture_unit skyboxMap
            {
                cubic_texture front.png back.png right.png left.png top.png bottom.png separateUV
                tex_address_mode clamp
                filtering trilinear
            }
        }
    }
}

material HelloMine3D/Terrain
{
    technique
    {
        pass
        {
            lighting off
            depth_write on
            cull_hardware none

            vertex_program_ref HelloMine3D/TerrainVertex
            {
            }

            fragment_program_ref HelloMine3D/TerrainFragment
            {
            }

            texture_unit terrainAtlas
            {
                texture DefaultPack.png
                tex_address_mode clamp
                filtering none
            }
        }
    }
}

material HelloMine3D/Water
{
    technique
    {
        pass
        {
            lighting off
            depth_write off
            scene_blend alpha_blend
            cull_hardware none

            vertex_program_ref HelloMine3D/WaterVertex
            {
            }

            fragment_program_ref HelloMine3D/TerrainFragment
            {
            }

            texture_unit terrainAtlas
            {
                texture DefaultPack.png
                tex_address_mode clamp
                filtering none
            }
        }
    }
}

material HelloMine3D/Transparent
