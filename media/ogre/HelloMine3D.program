vertex_program HelloMine3D/SkyboxVertex glsl
{
    source HelloMine3DSkybox.vert
    syntax glsl150
    default_params
    {
        param_named_auto worldViewProj worldviewproj_matrix
    }
}

fragment_program HelloMine3D/SkyboxFragment glsl
{
    source HelloMine3DSkybox.frag
    syntax glsl150
    default_params
    {
        param_named skyboxMap int 0
        param_named skyTint float3 1.0 1.0 1.0
    }
}

vertex_program HelloMine3D/TerrainVertex glsl
{
    source HelloMine3DTerrain.vert
    syntax glsl150
    default_params
    {
        param_named_auto worldViewProj worldviewproj_matrix
        param_named_auto worldView worldview_matrix
    }
}

fragment_program HelloMine3D/TerrainFragment glsl
{
    source HelloMine3DTerrain.frag
    syntax glsl150
    default_params
    {
        param_named terrainAtlas int 0
        param_named environmentLight float 1.0
        param_named fogColour float3 0.58 0.75 0.92
        param_named fogDensity float 0.0015
    }
}

vertex_program HelloMine3D/WaterVertex glsl
{
    source HelloMine3DWater.vert
    syntax glsl150
    default_params
    {
        param_named_auto worldViewProj worldviewproj_matrix
        param_named_auto worldView worldview_matrix
        param_named_auto globalTime time_0_x 1.0
    }
}

vertex_program HelloMine3D/FloraVertex glsl
{
    source HelloMine3DFlora.vert
    syntax glsl150
    default_params
    {
        param_named_auto worldViewProj worldviewproj_matrix
        param_named_auto worldView worldview_matrix
        param_named_auto globalTime time_0_x 1.0
    }
}

vertex_program HelloMine3D/OutlineVertex glsl
{
    source HelloMine3DOutline.vert
    syntax glsl150
    default_params
    {
        param_named_auto worldViewProj worldviewproj_matrix
    }
}

fragment_program HelloMine3D/OutlineFragment glsl
{
    source HelloMine3DOutline.frag
    syntax glsl150
}

vertex_program HelloMine3D/ActorVertex glsl
{
    source HelloMine3DActor.vert
    syntax glsl150
    default_params
    {
        param_named_auto worldViewProj worldviewproj_matrix
        param_named_auto worldView worldview_matrix
    }
}

fragment_program HelloMine3D/ActorFragment glsl
{
    source HelloMine3DActor.frag
    syntax glsl150
    default_params
    {
        param_named environmentLight float 1.0
