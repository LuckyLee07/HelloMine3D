vertex_program HelloMine3D/SkyboxVertex glsl
{
    source HelloMine3DSkybox.vert
    syntax glsl150
    default_params
    {
        param_named_auto worldViewProj worldviewproj_matrix
    }
}

fragment_program HelloMine3D/SkyboxFragment glsl
{
    source HelloMine3DSkybox.frag
    syntax glsl150
    default_params
    {
        param_named skyZenithColour float3 0.12 0.46 0.88
        param_named skyHorizonColour float3 0.58 0.75 0.92
        param_named sunDirection float3 0.0 1.0 0.0
        param_named sunColour float3 1.0 0.92 0.72
        param_named sunIntensity float 1.0
        param_named moonIntensity float 0.0
        param_named starIntensity float 0.0
        param_named cloudLightColour float3 0.90 0.93 0.95
        param_named cloudShadowColour float3 0.42 0.53 0.60
        param_named cloudCoverage float 0.46
        param_named fogSunwardColour float3 0.78 0.70 0.59
        param_named fogDirectionalStrength float 0.12
        param_named cloudLayerEnabled float 1.0
        param_named cloudBaseHeight float 168.0
        param_named cloudThickness float 24.0
        param_named cloudHorizontalScale float 92.0
        param_named cloudVelocity float2 1.6 0.55
        param_named cloudMaxDistance float 2400.0
        param_named_auto cameraPosition camera_position
        param_named_auto globalTime time 1.0
        param_named_auto legacyTime time_0_x 1.0
    }
}

vertex_program HelloMine3D/TerrainVertex glsl
{
    source HelloMine3DTerrain.vert
    syntax glsl150
    default_params
    {
        param_named_auto worldViewProj worldviewproj_matrix
        param_named_auto worldView worldview_matrix
        param_named_auto world world_matrix
    }
}

fragment_program HelloMine3D/TerrainFragment glsl
{
    source HelloMine3DTerrain.frag
    syntax glsl150
    default_params
    {
        param_named terrainAtlas int 0
        param_named atlasPixels float 256.0
        param_named tilePixels float 16.0
        param_named tilesPerRow float 16.0
        param_named colourSaturation float 0.62
        param_named greenSuppression float 0.22
        param_named greenRedShift float 0.07
        param_named toneGamma float 1.05
        param_named environmentLight float 1.0
        param_named fogColour float3 0.58 0.75 0.92
        param_named fogSunwardColour float3 0.78 0.70 0.59
        param_named sunDirection float3 0.0 1.0 0.0
        param_named fogDirectionalStrength float 0.12
        param_named fogDensity float 0.0015
        param_named_auto cameraPosition camera_position
    }
}

