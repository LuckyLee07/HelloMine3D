fragment_program HelloMine3D/HdrResolveFragment glsl
{
    source HelloMine3DHdrResolve.frag
    syntax glsl150
    default_params
    {
        param_named sceneTexture int 0
        param_named exposure float 1.0
        param_named spatialAaStrength float 1.0
        param_named_auto inverseTextureSize inverse_texture_size 0
    }
}
