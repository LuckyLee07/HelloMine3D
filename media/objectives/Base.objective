# HelloMine3D objective registry v1

version 1

objective alpha.gather_wood
type break_block
target hellomine:oak_bark
required 11
prerequisite none
visible 1
optional 0
title "Start with wood"
instruction "Collect 11 Oak Bark for a Workbench and tools."
feedback "Enough Oak Bark collected"
end

objective alpha.craft_workbench
type craft_item
target hellomine:workbench
required 1
prerequisite alpha.gather_wood
visible 1
optional 0
title "Craft a Workbench"
instruction "Press E and fill the 2x2 grid with Oak Bark."
feedback "Workbench crafted"
end

objective alpha.place_workbench
type place_block
target hellomine:workbench
required 1
prerequisite alpha.craft_workbench
visible 1
optional 0
title "Place the Workbench"
instruction "Select the Workbench and place it nearby."
feedback "Workbench placed"
end

objective alpha.craft_wooden_pickaxe
type craft_item
target hellomine:wooden_pickaxe
required 1
prerequisite alpha.place_workbench
visible 1
optional 0
title "Craft a Wooden Pickaxe"
instruction "Use the Workbench: 3 Oak Bark over 2 handles."
feedback "Wooden Pickaxe crafted"
end

objective alpha.gather_stone
type break_block
target hellomine:stone
required 3
prerequisite alpha.craft_wooden_pickaxe
visible 1
optional 0
title "Mine Stone"
instruction "Use the Wooden Pickaxe to collect 3 Stone."
feedback "Enough Stone collected"
end

objective alpha.craft_stone_pickaxe
type craft_item
target hellomine:stone_pickaxe
required 1
prerequisite alpha.gather_stone
visible 1
optional 0
title "Craft a Stone Pickaxe"
instruction "Use 3 Stone and 2 Oak Bark at the Workbench."
feedback "Stone Pickaxe crafted"
end

objective alpha.gather_iron_ore
type obtain_item
target hellomine:iron_ore
required 1
prerequisite alpha.craft_stone_pickaxe
visible 1
optional 0
title "Mine Iron Ore"
instruction "Iron drops only when mined with the Stone Pickaxe."
feedback "Iron Ore acquired"
end

objective alpha.defeat_mob
type defeat_enemy
required 1
prerequisite alpha.gather_iron_ore
visible 1
optional 0
title "Defeat an enemy"
instruction "Find a roaming Mob and attack until it drops loot."
feedback "Enemy defeated"
end

objective alpha.collect_mob_loot
type pickup_item
target hellomine:dirt
required 1
prerequisite alpha.defeat_mob
visible 1
optional 0
title "Collect the loot"
instruction "Move close to the dropped item to pick it up."
feedback "Enemy loot collected"
end

objective alpha.reopen_world
type reopen_world
required 1
prerequisite alpha.collect_mob_loot
visible 1
optional 0
title "Save and continue"
instruction "Pause, save to the main menu, then reopen this world."
feedback "First session complete"
end

objective alpha.reach_spawn_marker
type reach_location
required 1
location 3038.5 66 1922.5 8
prerequisite none
visible 0
optional 1
title "Reach the Alpha start"
instruction "Enter the fixed Alpha start area."
feedback "Alpha start reached"
end

objective progression.craft_furnace
type craft_item
target hellomine:furnace
required 1
prerequisite alpha.reopen_world
visible 1
optional 0
title "Build a Furnace"
instruction "Mine 8 Stone, then craft a Furnace at the Workbench."
feedback "Furnace crafted"
end

objective progression.place_furnace
type place_block
target hellomine:furnace
required 1
prerequisite progression.craft_furnace
visible 1
optional 0
title "Place the Furnace"
instruction "Place the Furnace near your Workbench."
feedback "Furnace placed"
end

objective progression.smelt_iron
type smelt_item
target hellomine:iron_ingot
required 5
prerequisite progression.place_furnace
visible 1
optional 0
title "Smelt Iron"
instruction "Put Iron Ore in the input and Coal Ore in the fuel slot; smelt 5 ingots."
feedback "Iron supply ready"
end

objective progression.craft_iron_pickaxe
type craft_item
target hellomine:iron_pickaxe
required 1
prerequisite progression.smelt_iron
visible 1
optional 0
title "Craft an Iron Pickaxe"
instruction "Use 3 Iron Ingots and 2 Oak Bark at the Workbench."
feedback "Iron Pickaxe crafted"
end

objective progression.craft_iron_sword
type craft_item
target hellomine:iron_sword
required 1
prerequisite progression.craft_iron_pickaxe
visible 1
optional 0
title "Craft an Iron Sword"
instruction "Use 2 Iron Ingots over 1 Oak Bark at the Workbench."
feedback "Iron progression complete"
end

objective survival.craft_bread
type craft_item
target hellomine:bread
required 1
prerequisite progression.craft_iron_sword
visible 1
optional 0
title "Bake Bread"
instruction "Harvest 3 Wheat and craft a loaf of Bread at the Workbench."
feedback "Bread crafted"
end

objective survival.eat_bread
type consume_item
target hellomine:bread
required 1
prerequisite survival.craft_bread
visible 1
optional 0
title "Recover with Food"
instruction "After taking damage, hold Bread and press R to restore health."
feedback "Food recovery complete"
end

objective combat.defeat_enemies
type defeat_enemy
required 3
prerequisite survival.eat_bread
visible 1
optional 0
title "Clear the Threat"
instruction "Defeat 3 Stalkers or Brutes and learn their combat rhythm."
feedback "Enemy threat contained"
end

objective combat.collect_wheat
type pickup_item
target hellomine:wheat
required 2
prerequisite combat.defeat_enemies
visible 1
optional 0
title "Recover Enemy Supplies"
instruction "Collect 2 Wheat dropped by defeated enemies."
feedback "Wheat supplies recovered"
end

objective combat.collect_coal
type pickup_item
target hellomine:coal_ore
required 1
prerequisite combat.collect_wheat
visible 1
optional 0
title "Claim Brute Spoils"
instruction "Defeat a Brute and collect 1 Coal Ore from its loot."
feedback "Combat progression complete"
end
