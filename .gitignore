/.vcpkg/
# Build output and per-user runtime state live in bin/. Only the three runtime
# templates below are repository-owned.
/bin/*
!/bin/Mine.cfg
!/bin/MineResources.cfg
!/bin/resource-packs.txt
/build/
/vcpkg_installed/
/packages/
__pycache__/
*.pyc
/MineOgre.log
/tools/tracy-viewer/tracy-profiler.exe
/tmp/*

# 验收截图、对照图和录像只保留本地；报告、数据与哈希仍纳入版本管理。
/docs/reports/**/*.png
/docs/reports/**/*.jpg
/docs/reports/**/*.jpeg
/docs/reports/**/*.webp
/docs/reports/**/*.gif
/docs/reports/**/*.mp4
/docs/reports/**/*.mov
/docs/reports/**/*.m4v
/docs/reports/**/*.webm
